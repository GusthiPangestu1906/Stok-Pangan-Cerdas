{
    "/api/login": {
        "post": {
            "tags": [
                "Autentikasi & Publik"
            ],
            "summary": "Login admin",
            "description": "Melakukan autentikasi admin koperasi dan menghasilkan Personal Access Token (Sanctum).",
            "requestBody": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "email",
                                "password"
                            ],
                            "properties": {
                                "email": {
                                    "type": "string",
                                    "format": "email",
                                    "example": "admin@koperasipangan.id"
                                },
                                "password": {
                                    "type": "string",
                                    "format": "password",
                                    "example": "admin123"
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Login berhasil",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "data": {
                                        "type": "object",
                                        "properties": {
                                            "user": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "Admin Koperasi Pangan"
                                                    },
                                                    "email": {
                                                        "type": "string",
                                                        "example": "admin@koperasipangan.id"
                                                    }
                                                }
                                            },
                                            "token": {
                                                "type": "string",
                                                "example": "1|abcdef1234567890..."
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "422": {
                    "description": "Email atau kata sandi salah"
                }
            }
        }
    },
    "/api/logout": {
        "post": {
            "tags": [
                "Autentikasi & Publik"
            ],
            "summary": "Logout admin",
            "description": "Mencabut token Sanctum aktif yang sedang digunakan.",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "responses": {
                "204": {
                    "description": "Logout berhasil"
                },
                "401": {
                    "description": "Unauthenticated"
                }
            }
        }
    },
    "/api/me": {
        "get": {
            "tags": [
                "Autentikasi & Publik"
            ],
            "summary": "Profil admin saat ini",
            "description": "Mengambil informasi data user admin yang sedang terautentikasi.",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "responses": {
                "200": {
                    "description": "Data user admin",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "data": {
                                        "type": "object",
                                        "properties": {
                                            "id": {
                                                "type": "integer",
                                                "example": 1
                                            },
                                            "name": {
                                                "type": "string",
                                                "example": "Admin Koperasi Pangan"
                                            },
                                            "email": {
                                                "type": "string",
                                                "example": "admin@koperasipangan.id"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "401": {
                    "description": "Unauthenticated"
                }
            }
        }
    }
}