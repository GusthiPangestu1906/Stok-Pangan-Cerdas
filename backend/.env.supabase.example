# ==============================================================================
# CONTOH KONFIGURASI SUPABASE POSTGRESQL UNTUK STOK PANGAN CERDAS
# ==============================================================================

# CARA 1: Menggunakan DATABASE_URL (Sangat Direkomendasikan di Render)
# Dapatkan di Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Contoh URI Transaction / Session Pooler:
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# CARA 2: Menggunakan Variabel Individual
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.[YOUR-PROJECT-REF]
DB_PASSWORD=[YOUR-SUPABASE-PASSWORD]
DB_SSLMODE=require

# PENTING UNTUK MIGRATION & SEED DI SUPABASE:
# - Disarankan memakai port 5432 (Session Mode) untuk proses migration Laravel.
# - Pastikan DB_SSLMODE=require karena Supabase mewajibkan koneksi SSL terenkripsi.
